# Copiez ce fichier vers server/.env et renseignez vos clés. Ne committez jamais le vrai .env.
# Clés Stripe : https://dashboard.stripe.com/apikeys (utilisez d'abord les clés TEST : sk_test_...).

STRIPE_SECRET_KEY=sk_test_xxx
# Depuis `stripe listen` ou les réglages Webhook du Dashboard (whsec_...). Optionnel mais recommandé.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URL publique du site (utilisée pour les redirections Stripe succès/annulation).
BASE_URL=http://localhost:4321
PORT=4321
