# Copy to server/.env and fill in. Never commit the real .env.
# Get your keys at https://dashboard.stripe.com/apikeys (use TEST keys first: sk_test_...).

STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` or the Dashboard webhook settings (whsec_...). Optional but recommended.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of the site (used for Stripe success/cancel redirects).
BASE_URL=http://localhost:4242
PORT=4242

# Email confirmation (optional). Get a key at https://resend.com (free tier).
# MAIL_FROM must use a domain you verified in Resend, e.g. "Paname Roof <noreply@tondomaine.com>".
# For quick tests you can use "Paname Roof <onboarding@resend.dev>" (delivers to your own account email only).
RESEND_API_KEY=re_xxx
MAIL_FROM=Paname Roof <onboarding@resend.dev>
